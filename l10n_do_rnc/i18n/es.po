#. module: l10n_do_rnc
#: model_terms:ir.ui.view,arch_db:l10n_do_rnc.res_config_settings_view_form_inherit_l10n_do_rnc
msgid ""
"Enable the RNC offline query function in case the DGII does not provide a "
"result."
msgstr ""
"Habilitar la función de consulta offline del RNC en caso de que la DGII no "
"proporcione un resultado."

#. module: l10n_do_rnc
#. odoo-python
#: code:addons/l10n_do_rnc/models/res_partner.py:0
#, python-format
msgid ""
"Example: '22400504056' or '133195593' (format: 9 digits for RNC or 11 "
"Digits for Cedula, all numbers.)"
msgstr ""
"Ejemplo: \"22400504056\" o \"133195593\" (formato: 9 dígitos para RNC u 11 "
"dígitos para Cédula, todos los números.)"

#. module: l10n_do_rnc
#. odoo-python
#: code:addons/l10n_do_rnc/models/res_partner.py:0
#, python-format
msgid "ID"
msgstr "Cédula"

#. module: l10n_do_rnc
#. odoo-python
#: code:addons/l10n_do_rnc/models/res_partner.py:0
#, python-format
msgid "Please verify the RNC/ID. It must have 9 digits for RNC or 11 for ID."
msgstr ""
"Por favor, verifique el RNC/ID. Debe tener 9 dígitos para RNC u 11 para ID."

#. module: l10n_do_rnc
#. odoo-python
#: code:addons/l10n_do_rnc/models/res_partner.py:0
#, python-format
msgid "RNC"
msgstr "RNC"

#. module: l10n_do_rnc
#: model:ir.model,name:l10n_do_rnc.model_rnc_cache
msgid "RNC Cache Manager"
msgstr "Gestor de caché de RNC"

#. module: l10n_do_rnc
#: model:ir.model.fields,field_description:l10n_do_rnc.field_res_config_settings__rnc_data_fallback
msgid "RNC Data Fallback"
msgstr "Consulta nombre RNC offline"

#. module: l10n_do_rnc
#. odoo-python
#: code:addons/l10n_do_rnc/models/res_partner.py:0
#, python-format
msgid ""
"The company name could not be found, consider use RNC fallback option in "
"the settings to search the name in the RNC local database.\n"
"\n"
"Error context: \n"
"%s"
msgstr ""
"No se ha podido encontrar el nombre del contribuyente, considere utilizar "
"la opción \"Consulta nombre RNC offline\" en la configuración para buscar "
"el nombre en la base de datos de RNCs local.\n"
"\n"
"Contexto de error:\n"
"%s"

#. module: l10n_do_rnc
#. odoo-python
#: code:addons/l10n_do_rnc/models/res_partner.py:0
#, python-format
msgid ""
"The company name could not be found, please enter the name manually and the "
"RNC/Cedula in the RNC field of the interface.\n"
"\n"
"Error context: \n"
"%s"
msgstr ""
"No se ha encontrado el nombre del contribuyente, introduzca el nombre "
"manualmente y el RNC/Cédula en el campo RNC de la interfaz.\n"
"\n"
"Contexto de error:\n"
"%s"

#. module: l10n_do_rnc
#. odoo-python
#: code:addons/l10n_do_rnc/models/res_partner.py:0
#, python-format
msgid "The contact %s already exists with the %s: %s."
msgstr "El contacto %s ya existe con el numero de %s: %s."

#. module: l10n_do_rnc
#. odoo-python
#: code:addons/l10n_do_rnc/models/res_partner.py:0
#, python-format
msgid "The entered RNC/ID is not valid."
msgstr "El RNC/ID introducido no es válido."

#. module: l10n_do_rnc
#: model_terms:ir.ui.view,arch_db:l10n_do_rnc.view_res_partner_form
msgid "e.g. Brandom Freeman or Cedula e.g. NNNNNNNNNNN"
msgstr "por ejemplo, Brandom Freeman o Cédula, por ejemplo, NNNNNNNNNNNN"

#. module: l10n_do_rnc
#: model_terms:ir.ui.view,arch_db:l10n_do_rnc.view_res_partner_form
msgid "e.g. Lumber Inc or RNC e.g. NNNNNNNNN"
msgstr "por ejemplo, Lumber Inc o RNC, por ejemplo, NNNNNNNNN"
