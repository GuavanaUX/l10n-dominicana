<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <template id="fiscal_info">
    <h5 t-if="o.fiscal_type_id">
      <t t-if="o.fiscal_type_id.prefix == 'B13'">
        <span t-field="o.fiscal_type_id.name" />
      </t>
      <t t-else="">Invoice of <span t-field="o.fiscal_type_id.name" />
      </t>
    </h5>
    <div t-if="o.ref">
      <strong>
        <t t-if="'E' in o.fiscal_type_id.prefix">e-NCF:</t>
        <t t-else="">NCF:</t>
      </strong>
      <span t-field="o.ref" />
    </div>
    <div t-if="o.move_type in ['in_refund', 'out_refund'] and o.origin_out">
      <strong>NCF modified:</strong>
      <span t-field="o.origin_out" />
    </div>
    <div id="fiscal_exp_date"
      t-if="o.move_type in ['out_invoice','out_refund'] and o.state == 'posted' and o.ref 
                 and o.fiscal_type_id and o.fiscal_type_id.prefix[1:] not in ('32','34','02') 
                 and o.ncf_expiration_date">
      <strong>
        <t t-if="ecf_representation">Expiration e-NCF:</t>
        <t t-else="">Valid until:</t>
      </strong>
      <span t-field="o.ncf_expiration_date" />
    </div>
    <h5></h5>
  </template>

  <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">

    <xpath expr="//div[@name='address_not_same_as_shipping']//address" position="before">
      <div
        t-if="o.is_l10n_do_fiscal_invoice and o.is_invoice() and o.fiscal_type_id and o.fiscal_type_id.assigned_sequence">
        <t t-call="l10n_do_accounting.fiscal_info" />
      </div>
    </xpath>

    <xpath expr="//div[@name='address_same_as_shipping']" position="replace" />
    <xpath expr="//div[@name='no_shipping']" position="replace" />

    <xpath expr="//div[hasclass('clearfix')]" position="before">
      <t t-if="o.partner_shipping_id and (o.partner_shipping_id == o.partner_id)">
        <div class="row mt-4 mb-4">
          <div class="col-6">
            <address class="mb-0" t-field="o.partner_id"
              t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />
            <div t-if="o.partner_id.vat">
              <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                t-out="o.company_id.account_fiscal_country_id.vat_label" />
                    <t t-else="">Tax ID</t>: <span
                t-field="o.partner_id.vat" />
            </div>
          </div>

          <div class="col-6 text-end">
            <div
              t-if="o.is_l10n_do_fiscal_invoice and o.is_invoice() and o.fiscal_type_id and o.fiscal_type_id.assigned_sequence">
              <t t-call="l10n_do_accounting.fiscal_info" />
            </div>
          </div>
        </div>
      </t>
    </xpath>

    <xpath expr="//div[@name='reference']" position="attributes">
      <attribute name="t-if">not o.is_l10n_do_fiscal_invoice</attribute>
    </xpath>

  </template>

</odoo>