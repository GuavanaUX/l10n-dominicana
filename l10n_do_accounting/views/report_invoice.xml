<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">

    <xpath expr="//div[hasclass('row')]" position="replace" />

    <xpath expr="//div[hasclass('clearfix')]" position="before">
      <div class="row">
        <div class="col-6">
          <t t-set="information_block">
            <div>
              <strong>Cliente:</strong>
              <span t-field="o.partner_id.name" />
            </div>

            <div t-if="o.partner_id.vat">
              <strong>RNC:</strong>
              <span t-field="o.partner_id.vat" />
            </div>
          </t>
        </div>
        <t t-set="address">
          <div class="col-6">

          </div>
        </t>
      </div>
    </xpath>

    <xpath expr="//div[@name='reference']" position="attributes">
      <attribute name="t-if">not o.is_l10n_do_fiscal_invoice</attribute>
    </xpath>

    <xpath expr="//div[@name='invoice_date']" position="attributes">
      <attribute name="t-if">not o.is_l10n_do_fiscal_invoice</attribute>
    </xpath>

    <xpath expr="//div[@name='due_date']" position="attributes">
      <attribute name="t-if">not o.is_l10n_do_fiscal_invoice</attribute>
    </xpath>

    <!-- TABLE -->

    <xpath expr="//t[@t-set='current_total']" position="after">
      <t t-set="line_tax" t-value="0" />
      <t t-set="exempt_total" t-value="0" />
    </xpath>

    <!-- FOREACH -->

    <xpath expr="//t[@t-foreach]/t[@t-set='current_total']" position="after">
      <t t-set="line_tax_exempt" t-value="not any(t.amount > 0 for t in line.tax_ids)" />
      <t t-set="line_tax"
        t-value="line.price_subtotal * sum(t.amount / 100.0 for t in line.tax_ids if t.amount > 0)" />
      <t t-set="exempt_total"
        t-value="exempt_total + (line.price_subtotal if line_tax_exempt and line.display_type == 'product' else 0)" />
    </xpath>

    <!-- Quantity -->

    <xpath expr="//th[@name='th_quantity']" position="replace" />
    <xpath expr="//td[@name='td_quantity']" position="replace" />

    <xpath expr="//th[@name='th_description']" position="before">
      <th name="th_quantity" class="text-center">
        <span>Cantidad</span>
      </th>
    </xpath>

    <xpath expr="//td[@name='account_invoice_line_name']" position="before">
      <td name="td_quantity" class="o_td_quantity text-center">
        <span t-field="line.quantity" class="text-nowrap">3.00</span>
      </td>
    </xpath>

    <!-- Description -->

    <xpath expr="//th[@name='th_description']" position="attributes">
      <attribute name="class">text-center</attribute>
    </xpath>

    <!-- Measure unit -->

    <xpath expr="//th[@name='th_description']" position="after">
      <th name="th_measure_unit" class="text-center">
        <span>Unidad de medida</span>
      </th>
    </xpath>
    <xpath expr="//td[@name='account_invoice_line_name']" position="after">
      <td name="td_measure_unit" class="text-center">
        <span t-field="line.product_uom_id" class="text-center"></span>
      </td>
    </xpath>

    <!-- Price Unit -->

    <xpath expr="//td[@name='td_price_unit']/span" position="attributes">
      <attribute name="t-options">{"widget": "monetary", "display_currency": o.currency_id}</attribute>
    </xpath>

    <!-- Taxes -->

    <xpath expr="//th[@name='th_taxes']" position="replace">
      <th name="th_taxes"
        t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
        <span>ITBIS</span>
      </th>
    </xpath>

    <xpath expr="//td[@name='td_taxes']" position="replace">
      <td name="tax_line" class="text-end o_price_total">
        <t t-if="line_tax_exempt">
          <span class="text-nowrap">E</span>
        </t>
        <t t-else="">
          <span class="text-nowrap" t-out="line_tax"
            t-options='{"widget": "monetary", "display_currency": o.currency_id}'>27.00</span>
        </t>
      </td>
    </xpath>

    <!-- Price Total -->

    <xpath expr="//th[@name='th_subtotal']" position="replace">
      <th name="th_subtotal" class="text-end">
        <span>Valor</span>
      </th>
    </xpath>

    <xpath expr="//td[@name='td_subtotal']" position="replace">
      <td name="td_subtotal" class="text-end o_price_total">
        <span class="text-nowrap" t-field="line.price_total">27.00</span>
      </td>
    </xpath>

    <!-- SUBTOTAL -->

    <xpath expr="//strong[hasclass('mr16')]" position="replace">
      <strong class="mr16">Subtotal Engraved</strong>
    </xpath>

    <xpath expr="//p[@name='payment_communication']" position="replace" />

  </template>

</odoo>