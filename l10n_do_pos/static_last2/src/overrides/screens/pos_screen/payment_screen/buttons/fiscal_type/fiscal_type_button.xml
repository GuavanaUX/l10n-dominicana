<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_do_pos.FiscalTypeButton" t-inherit="point_of_sale.PaymentScreenButtons"
        t-inherit-mode="extension">
        <xpath expr="//button[hasclass('partner-button')]" position="after">
            <button class="button partner-button btn btn-light btn-lg w-100 w-md-50 lh-lg text-truncate"
                t-on-click="selectPartner2">
                <i class="fa fa-file-text-o me-2" role="img" title="Fiscal Type"></i>
                <span class="partner-name">
                    <t t-if="currentOrder.get_partner()" t-esc="currentOrder.get_partner().name"/>
                    <t t-else="">Fiscal Type</t>
                </span>
            </button>
        </xpath>
    </t>

</templates>