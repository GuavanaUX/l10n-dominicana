<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_do_pos.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension" owl="1">
        <xpath expr="//button[hasclass('partner-button')]" position="after">
            <t t-if="pos.config.l10n_do_fiscal_journal">
                <button class="set-partner btn btn-light btn-lg lh-lg text-truncate w-auto">
                    <i class="fa fa-edit" role="img" aria-label="Set Type position" title="Set fiscal Type"/>
                    <t t-esc='currentFiscalTypeName'/>
                </button>
            </t>
        </xpath>

        <!-- TODO: Verify location in version 18 -->
