<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_do_pos.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension" owl="1">
        <xpath expr="//button[hasclass('partner-button')]" position="after">
            <t t-if="pos.config.l10n_do_fiscal_journal">
                <SetFiscalTypeButton/>
            </t>
        </xpath>

        <!-- TODO: Verify location in version 18 -->
        <!-- 
        <xpath expr="//div[hasclass('right-content')]" position="attributes">
            <attribute name="t-att-class">env.pos.isCreditNoteMode() ? 'no-clickeable' : '' </attribute>
        </xpath> 
        -->
        
        <xpath expr="//button[hasclass('js_invoice')]" position="attributes">
            <attribute name="t-if">!pos.config.l10n_do_fiscal_journal</attribute>
        </xpath>
    </t>

    <t t-name="l10n_do_pos.PaymentScreenMethods" t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('paymentmethods-container')]" position="attributes">
            <attribute name="t-att-class">this.isCreditNoteMode() ? 'no-clickeable' : '' </attribute>
        </xpath>
    </t>

    <t t-name="l10n_do_pos.Numpad" t-inherit="point_of_sale.Numpad" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[@t-attf-class('numpad')]" position="attributes">
            <attribute name="t-att-class">this.isCreditNoteMode() ? 'no-clickeable' : '' </attribute>
        </xpath>
    </t>

</templates>
