<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_do_pos.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <t t-if="pos.config.l10n_do_fiscal_journal">
                <div class="d-flex flex-column flex-sm-row gap-2 w-100">
                    <button class="button btn btn-light btn-lg w-100 w-md-50 lh-lg text-truncate" t-on-click="onClickTest">
                        <i class="fa fa-file-text-o me-2" role="img" title="Test Button"></i>
                        <span>
                            Test Button
                        </span>
                    </button>
                </div>
            </t>
        </xpath>
    </t>
</templates>