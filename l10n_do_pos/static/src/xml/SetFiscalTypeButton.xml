<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_do_pos.SetFiscalTypeButton">
        <button class="button btn btn-light btn-lg d-flex justify-content-between align-items-baseline w-100 w-md-50 lh-lg" style="color:red"
            t-on-click="() => this.onClick()">
            <span>
                <i class="fa fa-edit me-2" aria-label="Set Type position"/>
                <t t-if="currentFiscalTypeName" t-esc='currentFiscalTypeName'/>
                <t t-else="">Set fiscal Type"</t>
            </span>
        </button>
    </t>
</templates>
