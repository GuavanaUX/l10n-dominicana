<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('header-row')]/div[1]" position="after">
            <t t-if="this.pos.config.l10n_do_fiscal_journal">
                <div class="col wide p-2">NCF</div>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('order-row')]/div[1]" position="after">
            <t t-if="this.pos.config.l10n_do_fiscal_journal">
                <div class="col wide p-2">
                    <div><t t-esc="order.ncf"></t></div>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('control-buttons')]" position="after">
            <div class="control-buttons d-flex flex-column pb-2">
                <button class="control-button btn btn-light btn-lg lh-lg"
                    t-on-click="() => this._returnAllOrder()" >
                    <i class="fa fa-bars"></i>
                    <span> </span>
                    <span>Return all products</span>
                </button>
            </div>
        </xpath>
    </t>
</templates>
