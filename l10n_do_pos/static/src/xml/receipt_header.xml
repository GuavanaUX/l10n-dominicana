<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_do_pos.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('d-flex flex-column align-items-center')]" position="after">
            <t t-if="props.data.l10n_do_fiscal_journal">
                <div class="d-flex flex-column">
                    <div class="pos-receipt-font-75" t-if="props.data.partner">
                        <br/>
                        <div>
                            Customer: <t t-esc="props.data.partner.name"/>
                        </div>
                        <div t-if="props.data.partner.vat">
                            RNC / Cedula: <t t-esc="props.data.partner.vat"/>
                        </div>
                        <div t-if="props.data.partner.street">
                            <t t-esc="props.data.partner.street"/><t t-if="props.data.partner.street2" t-esc="', ' + props.data.partner.street2"/>
                        </div>
                        <div t-if="props.data.partner.city">
                            <t t-esc="props.data.partner.city"/>
                        </div>
                        <div t-if="props.data.partner.state_id">
                            <t t-esc="props.data.partner.state_id[1]"/>
                        </div>
                        <div t-if="props.data.partner.zip">
                            <t t-esc="props.data.partner.zip"/>
                        </div>
                        <div t-if="props.data.partner.country_id and props.data.partner.street">
                            <t t-esc="props.data.partner.country_id[1]"/>
                        </div>
                    </div>
                    <div t-if="props.data.ncf">
                        <br/>
                        <div class="pos-receipt-contact">
                            Authorized by DGII
                        </div>
                        <br/>
                        <div class="pos-receipt-font-75">
                            <div>
                                <t t-if="props.data.date">
                                    <div>
                                        <t t-esc="props.data.date" />
                                    </div>
                                </t>
                            </div>
                            <div>
                                NCF: <t t-esc="props.data.ncf"/>
                            </div>
                            <div>
                                Expiration date NCF: <t t-esc="props.data.ncf_expiration_date"/>
                            </div>
                            <div t-if="props.data.ncf_origin_out">
                                Affect: <t t-esc="props.data.ncf_origin_out"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
