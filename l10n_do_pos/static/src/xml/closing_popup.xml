<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_do_pos.ClosePosPopup" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <!-- 
        Close Register: disable while closing and show a spinner before
        the label, same pattern used for print/send buttons in
        receipt_screen.xml 
        -->
        <xpath expr="//button[@t-on-click='confirm']" position="replace">
            <button class="button highlight btn btn-primary" t-att-disabled="!canConfirm() || isClosingSession" t-on-click="confirm" t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'">
                <i t-if="isClosingSession" class="fa fa-fw fa-spin fa-circle-o-notch me-1"/>Close Register
            </button>
        </xpath>

        <!-- Every other button: disabled only, no spinner -->
        <xpath expr="//button[@t-on-click='cancel']" position="attributes">
            <attribute name="t-att-disabled">!canCancel() || isClosingSession</attribute>
        </xpath>
        <xpath expr="//button[@t-on-click='() =&gt; this.cashMove()']" position="attributes">
            <attribute name="t-att-disabled">isClosingSession</attribute>
        </xpath>
        <xpath expr="//button[@t-on-click='downloadSalesReport']" position="attributes">
            <attribute name="t-att-disabled">isClosingSession</attribute>
        </xpath>
        <xpath expr="//button[@t-if='hardwareProxy.printer']" position="attributes">
            <attribute name="t-att-disabled">isClosingSession</attribute>
        </xpath>
    </t>
</templates>