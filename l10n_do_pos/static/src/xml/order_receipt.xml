<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_do_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//ReceiptHeader" position="after">
            <t t-if="props.data.headerData.l10n_do_fiscal_journal">
                <div class="pos-receipt-fiscal-type-name" t-if="props.data.headerData.ncf">
                    <t t-esc="props.data.fiscal_type"/>
                </div>
                <div class="pos-receipt-titles">
                    <span>
                        DESCRIPTION
                    </span>
                    <span class="pos-receipt-right-align">
                        Value
                    </span>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[@class='text-center']" position="replace">
            <div t-if="!props.data.headerData.l10n_do_fiscal_journal" class="text-center">--------------------------------</div>
            <div t-if="props.data.headerData.l10n_do_fiscal_journal" class="pos-receipt-fiscal-type-name"></div>
        </xpath>
    </t>
</templates>
